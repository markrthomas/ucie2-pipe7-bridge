# SymbiYosys job -- PIPE 7.1 MAC PowerDown/Rate/Width control FSM.
# Phase F increment 3. Bounded model check (BMC), not an unbounded proof.
# Run via `make formal` from the repo root (it regenerates build/formal/src first).
#
# NOTE on the engine: `--unroll`. yosys-smtbmc's default (non-unrolled, uninterpreted
# -function) encoding is pathological for the apt z3 4.8.12 on this design -- it does
# not finish even at depth 2. The fully unrolled pure-bitvector encoding solves the
# same query in seconds.
[options]
mode bmc
depth 24
expect pass

[engines]
smtbmc --unroll z3

[script]
read -formal ucie2_pipe7_pkg.sv
read -formal pipe7_mac_ctrl_fsm.sv
read -formal pipe7_mac_ctrl_fsm_formal.sv
prep -top pipe7_mac_ctrl_fsm_formal

[files]
build/formal/src/ucie2_pipe7_pkg.sv
build/formal/src/pipe7_mac_ctrl_fsm.sv
formal/pipe7_mac_ctrl_fsm_formal.sv
