# Verilator / build artifacts
obj_dir/
obj_dir_*/
*.vcd
*.fst

# DV build/output
dv/pyuvm/sim_build/
dv/pyuvm/cov_build/
dv/pyuvm/wave_build/
dv/pyuvm/build/
dv/pyuvm/results.xml
dv/pyuvm/coverage.dat

# Coverage (make coverage)
build/coverage/

# Waves (make waves / make wave) -- the DUMPS are build artifacts. The curated
# GTKWave layouts in dv/waves/*.gtkw are deliberately COMMITTED (that is the
# whole point of `make wave-check`) and must NOT be ignored.
build/waves/

# Formal (make formal) -- generated yosys-readable RTL copies + sby work dirs
build/formal/

# Metrics (make metrics) -- per-tier tee'd logs only. metrics/metrics.db and
# metrics/dashboard.html are deliberately COMMITTED and must NOT be ignored.
build/metrics/
dv/uvm/vlt/obj/
dv/uvm/vcs/sim_*
dv/uvm/vcs/*.log
dv/uvm/vcs/csrc/
dv/uvm/vcs/simv.daidir/
*.trace

# Reports
report/

# Python
__pycache__/
*.pyc

# Formal (SymbiYosys)
verification/formal/*_bmc/
verification/formal/*_cover/

# Node (only used transiently for `railway config plan/apply`)
node_modules/
package-lock.json

# Local notes / editor
NOTES
.mcp.json
