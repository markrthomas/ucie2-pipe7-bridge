# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=ucie2-pipe7-bridge
GH_REPO=markrthomas/ucie2-pipe7-bridge
DUT_TOP=ucie2_pipe7_bridge

RTL_DIR=rtl
TB_DIR=dv

# two cycle-accurate TBs (PyUVM + SV UVM-on-Verilator), the B2B integration tiers, functional coverage and the
# byte-identical trace cross-check; `uvm` / `trace-compare` need the from-source Verilator (CI / container only)
DV_ENVS="pyuvm uvm b2b fcov trace-compare"
GATE_TARGET=check
CI_TARGET=uvm
CROSSCHECK_TARGET=trace-compare
INFRA_TARGETS="lint-uvm coverage formal eda-check"
HEAVY_TARGETS="uvm uvm-b2b trace-compare trace-compare-b2b ci"

MUTATION_FILE=rtl/ucie2_fdi_egress.sv
MUTATION_HINT="corrupt one data bit of the 128b FDI transfer on the egress path"

RR_DIR=dv/random
RR_STATUS=bootstrap

METRICS=no

# the image's UVM-capable Verilator (was hard-wired in the old docker/entrypoint.sh); --binary needs ~6 GB
MAKE_OVERRIDES="VERILATOR=/opt/verilator/bin/verilator UVM_HOME=/opt/verilator/uvm"
MIN_MEM_MB=6144
# repo-owned: Railway IaC lives in .railway/railway.ts (no railway.toml)
KIT_KEEP="railway.toml"
